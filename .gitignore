# ---- secrets and local configuration (never commit) ----
.env
.env.*
!.env.example
data/.secret
*.pem
*.key

# ---- local data ----
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite3

# ---- Python ----
backend/.venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / frontend ----
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.shot*.mjs
frontend/.dbg.mjs
npm-debug.log*

# ---- editors and OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- Office lock files ----
~$*

# ---- logs ----
*.log
logs/
*.local
