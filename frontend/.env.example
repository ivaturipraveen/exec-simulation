# ─── Frontend (web) — example (copy to frontend/.env) ────────────────────────────────────────
# Read by Vite from frontend/.env. Never commit this file.

# Dev server port (`make dev`)
WEB_PORT=5180
# Where the dev server proxies /api and /ws (the local API)
VITE_API_TARGET=http://127.0.0.1:8800

# API origin baked into a production build when the UI is hosted apart from the API
# (Render static site). Leave empty locally: the dev proxy or `make start` serves the API on the same host.
VITE_API_URL=
# e.g. VITE_API_URL=https://exec-simulation-api.onrender.com
