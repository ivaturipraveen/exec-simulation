# ─── Backend (API) — example (copy to backend/.env) ─────────────────────────────────────────
# Read by the API from backend/.env. Never commit this file.
# Relative paths (data, content, frontend/dist) resolve from the project root.
# Render production values live in backend/.env.production (also never committed).
# App
ENVIRONMENT=local
LOG_LEVEL=INFO

# Port (used by `make dev` / `make start`)
API_PORT=8800
# Comma-separated or JSON list. Add the deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Storage — local SQLite for now (Postgres later: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///data/exec_sim.db
DATA_DIR=data
CONTENT_DIR=content
STATIC_DIR=frontend/dist

# Settings screen (http://localhost:5180/settings): password required to change settings in the UI.
# Leave blank to disable the Settings screen. Never commit real values.
ADMIN_PASSWORD=

# Security — signs facilitator and team tokens. Changing it invalidates existing sessions.
SECRET_KEY=change-me-to-a-long-random-string

# Simulation and game rules (blank = use content/game.yaml, the Content Pack v0.1 defaults)
SIM_DEFAULT_SEED=42
# deterministic (midpoint of each effect range, comparable runs) | variable (draws within the range)
SIM_MODE=deterministic
# hybrid ($8.0M base + up to $4.0M earned on the board-pitch rubric) | fixed | differentiated
ROUND2_MECHANIC=hybrid
ROUND2_BASE_MUSD=8.0
# Band shown on projected results (0.20 = ±20% of effect)
CONFIDENCE_BAND=0.20
# Show the optional 25-minute real-company translation stage
INCLUDE_TRANSLATION=true
# Use Claude to suggest a board-pitch rubric score (facilitator always decides)
PITCH_AI_SUGGEST=true
# Opportunity Map retention (OD-09: 12 months)
OPPORTUNITY_RETENTION_DAYS=365

# AI analyst (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_MAX_TOKENS=8000
AI_REQUESTS_PER_10_MIN=20
# Claude effort for analyst answers: low | medium | high
AI_EFFORT=medium

